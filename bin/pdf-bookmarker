#!/usr/bin/env bash
set -e
DIR="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
if [ -x "$DIR/.venv/bin/python" ]; then
  DEFAULT_PYTHON="$DIR/.venv/bin/python"
else
  DEFAULT_PYTHON="python3"
fi
PYTHON="${PDF_BOOKMARKER_PYTHON:-$DEFAULT_PYTHON}"
cmd="${1:---help}"
if [ "$#" -gt 0 ]; then shift; fi
case "$cmd" in
  extraer|comprobar|aplicar) exec "$PYTHON" "$DIR/corregir_marcadores.py" "$cmd" "$@" ;;
  extraer-de-indice) exec "$PYTHON" "$DIR/extraer_de_indice.py" "$@" ;;
  verificar) exec "$PYTHON" "$DIR/verificar_paginas.py" "$@" ;;
  aprobar) exec "$PYTHON" "$DIR/aprobar_plan.py" "$@" ;;
  aplicar-forzado) exec "$PYTHON" "$DIR/aplicar_forzado.py" "$@" ;;
  aprender) exec "$PYTHON" "$DIR/memoria.py" "$@" ;;
  trabajar) exec "$PYTHON" "$DIR/seleccionar.py" "$@" ;;
  carpeta) exec "$PYTHON" "$DIR/procesar_carpeta.py" "$@" ;;
  -h|--help) echo 'pdf-bookmarker: trabajar, extraer, extraer-de-indice, verificar, comprobar, aplicar, aplicar-forzado, aprender, carpeta. Procesamiento local sin llamadas a modelos.' ;;
  *) echo "Subcomando desconocido: $cmd" >&2; exit 1 ;;
esac
